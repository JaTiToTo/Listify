SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8081/auth/callback
SPOTIFY_FRONTEND_REDIRECT_URI=http://localhost:5173/callback
SPOTIFY_SCOPES=playlist-read-private playlist-modify-public playlist-modify-private user-read-email user-read-private
CORS_CONFIG_ORIGINS=http://localhost:5173,http://127.0.0.1:5173